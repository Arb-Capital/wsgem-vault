# Copy to .env (gitignored). Everything here is OPTIONAL for development; the deploy
# targets state their own requirements.
#
# RPC precedence everywhere (make targets AND direct `forge test` — ForkBase resolves
# the same chain): explicit ETH_RPC_URL > ALCHEMY_API_KEY > public fallback
# (https://ethereum-rpc.publicnode.com, rate-limited — expect slower fork suites and
# the occasional 403 on archive requests).

# Alchemy API key (key only, not the full URL) — composed into
# https://eth-mainnet.g.alchemy.com/v2/<key> when ETH_RPC_URL is unset.
ALCHEMY_API_KEY=

# Or pin a full RPC URL directly (wins over ALCHEMY_API_KEY).
#ETH_RPC_URL=

# Pin the fork suite to a different block than the in-repo default (archive RPC needed).
#FORK_BLOCK=

# --- Deploy configuration ---
# The make targets drive script/DeployWstGbpVault.s.sol, which pins the whole wstGBP
# configuration in code (WSGEM, EXPECTED_GEM, VAULT_NAME, VAULT_SYMBOL): LEAVE THE FOUR
# VARS BELOW UNSET for it. A value that contradicts its pinned instance is refused rather
# than silently ignored.
#
# For any other wsgem, drive the generic pattern script — which defaults nothing, so all
# four are required: make deploy-dry SCRIPT=script/DeployWsgemVault.s.sol
#WSGEM=
#EXPECTED_GEM=
#VAULT_NAME=
#VAULT_SYMBOL=

# --- Deploy signing (make deploy only; never a raw private key) ---
#ETH_FROM=
#ETH_KEYSTORE=
# Explorer verification is also used by keyless make verify VAULT=0x...
#ETHERSCAN_API_KEY=

# Optional gas knobs: ETH_PRIO_FEE -> --priority-gas-price, ETH_GAS_PRICE -> --with-gas-price.
#ETH_PRIO_FEE=
#ETH_GAS_PRICE=
